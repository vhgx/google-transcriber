{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Transcrições locais",
  "version": "0.1.0",
  "identifier": "com.vitorh.yttxt",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Transcrições locais",
        "width": 920,
        "height": 760,
        "minWidth": 680,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "targets": ["app"],
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
